#!/usr/bin/env bash
# =============================================================================
# Chezmoi Script: Install Core Packages
# =============================================================================
# Detects the OS package manager at template render time, then installs each
# module one by one directly in this script. Package names are declared inline
# per module (no longer sourced from .chezmoidata.toml), so this run_onchange_
# script re-runs automatically whenever a module is added, removed, or changed.
#
# Add a new module by appending an `install_module` call below:
#   install_module <dnf> <apt> <pacman> <brew>
# Use "-" for a manager that has no matching package.

{{ $mgr := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $mgr = "brew" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $id := "" -}}{{ if hasKey .chezmoi.osRelease "id" }}{{ $id = .chezmoi.osRelease.id }}{{ end -}}
{{-   $idLike := "" -}}{{ if hasKey .chezmoi.osRelease "idLike" }}{{ $idLike = .chezmoi.osRelease.idLike }}{{ end -}}
{{-   $family := lower (printf "%s %s" $id $idLike) -}}
{{-   if regexMatch "fedora|rhel|centos|rocky|almalinux" $family -}}
{{-     $mgr = "dnf" -}}
{{-   else if regexMatch "debian|ubuntu|mint|pop" $family -}}
{{-     $mgr = "apt" -}}
{{-   else if regexMatch "arch|manjaro|endeavour" $family -}}
{{-     $mgr = "pacman" -}}
{{-   end -}}
{{- end -}}

set -euo pipefail

{{ if eq $mgr "" }}
echo "install-core: 未识别的系统 ({{ .chezmoi.os }}{{ if hasKey .chezmoi.osRelease "id" }}/{{ .chezmoi.osRelease.id }}{{ end }})，跳过核心工具安装。" >&2
exit 0
{{- else }}

MGR="{{ $mgr }}"

echo "install-core: 使用 $MGR 安装核心工具..."

{{ if eq $mgr "apt" }}
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update
{{- end }}

# install_module <dnf> <apt> <pacman> <brew>
# 根据当前包管理器选择对应名称并单独安装一个模块。"-" 表示该管理器无此包。
install_module() {
	local dnf_name="$1" apt_name="$2" pacman_name="$3" brew_name="$4"
	local name=""
	case "$MGR" in
		dnf) name="$dnf_name" ;;
		apt) name="$apt_name" ;;
		pacman) name="$pacman_name" ;;
		brew) name="$brew_name" ;;
	esac

	if [ -z "$name" ] || [ "$name" = "-" ]; then
		echo "install-core: 跳过（$MGR 无对应包）"
		return 0
	fi

	echo "install-core: 安装 $name ..."
	case "$MGR" in
		dnf) sudo dnf install -y "$name" ;;
		apt) sudo apt-get install -y "$name" ;;
		pacman) sudo pacman -Sy --needed --noconfirm "$name" ;;
		brew) brew install "$name" ;;
	esac
}

# 一个模块一个模块地安装
# install_module <dnf> <apt> <pacman> <brew>
install_module curl      curl    curl       curl
install_module nmap-ncat ncat    nmap       nmap
install_module eza       eza     eza        eza
install_module gh        gh      github-cli gh
install_module fzf       fzf     fzf        fzf
install_module fd-find   fd-find fd         fd
install_module tig       tig     tig        tig
install_module ripgrep   ripgrep ripgrep    ripgrep
install_module zsh       zsh     zsh        zsh
install_module tree      tree    tree       tree

# ghq 官方仓库大多未打包，直接下载官方 release 到 ~/.local/bin。
{{ if eq .chezmoi.os "darwin" -}}
GHQ_URL="https://github.com/x-motemen/ghq/releases/download/v1.10.1/ghq_darwin_amd64.zip"
{{- else -}}
GHQ_URL="https://github.com/x-motemen/ghq/releases/download/v1.10.1/ghq_linux_amd64.zip"
{{- end }}
if ! command -v ghq >/dev/null 2>&1; then
	echo "install-core: 安装 ghq ..."
	mkdir -p "$HOME/.local/bin"
	tmp="$(mktemp -d)"
	curl -fsSL -o "$tmp/ghq.zip" "$GHQ_URL"
	unzip -o "$tmp/ghq.zip" -d "$tmp" >/dev/null
	install -m 0755 "$tmp"/ghq_*/ghq "$HOME/.local/bin/ghq"
	rm -rf "$tmp"
fi

echo "install-core: 完成。"
{{- end }}
