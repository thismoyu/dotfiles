" M->cmd, A->option, C->control
" <ESC> - escape, <BS> - backspace, <CR> - return

let mapleader = " "          " 设置 Space 为 Leader 键

" ==============================================================================
" 1. 基础配置（与 Neovim 保持一致）
" ==============================================================================
set hlsearch                " 高亮搜索
set incsearch               " 增量搜索
set ignorecase smartcase    " 忽略大小写智能匹配
set clipboard+=unnamed      " 共享系统剪贴板
set clipboard+=ideaput

" 显示行号
set nu

"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins
" Highlight copied text
Plug 'machakann/vim-highlightedyank'

" https://github.com/JetBrains/ideavim/wiki/IdeaVim-Plugins
set surround                " 对应 vim-surround / nvim-surround (ys, cs, ds)
set commentary              " 对应 vim-commentary / Comment.nvim (gcc, gc)
set argtextobj              " 参数文本对象 (cia, daa)
set multiple-cursors


" <Action> 必须用 map/nmap（不能用 noremap/nnoremap），且 map 行不能写行尾注释
nmap <C-O> <Action>(Back)
nmap <C-I> <Action>(Forward)
nnoremap <C-D> <C-D>zz
nnoremap <C-U> <C-U>zz
nmap J <Action>(EditorJoinLines)

" 文件导航定位到当前文件
nmap <leader>` <Action>(SelectInProjectView)
" quit
nnoremap <leader>q :wq<CR>

" 代码跳转与查看
nmap gd <Action>(GotoDeclaration)
nmap gD <Action>(GotoTypeDeclaration)
nmap gi <Action>(GotoImplementation)
nmap gr <Action>(FindUsages)
nmap K  <Action>(QuickJavaDoc)

" 重构与代码修改
nmap <leader>rn <Action>(RenameElement)
nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>fm <Action>(ReformatCode)

" 错误/警告跳转 (仿 vim.diagnostic.goto_next/prev)
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)

" ==============================================================================
" 仿 Neovim Telescope / fzf 搜索快捷键 -> 映射到 IDE 搜索
" ==============================================================================
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fg <Action>(FindInPath)
nmap <leader>fb <Action>(RecentFiles)
nmap <leader>fs <Action>(GotoSymbol)
nmap <leader><space> <Action>(SearchEverywhere)

" 文件树切换 (仿 Neo-tree / Nvim-tree)
nmap <leader>e <Action>(ActivateProjectToolWindow)

" 窗口跳转 (与 Neovim 窗格跳转一致)
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
