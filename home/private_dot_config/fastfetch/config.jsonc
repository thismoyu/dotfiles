{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 0
        }
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
        {
            "type": "os",
            "key": "{icon}",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "",
            "keyColor": "yellow"
        },
        "break",

        {
            "type": "wm",
            "key": "",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "󰧨",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "󰉼",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "󰀻",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "",
            "keyColor": "blue"
        },

        "break",
        {
            "type": "host",
            "key": "󰌢",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "󰻠",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰍛",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰑭",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "󰍹",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "󰅐",
            "keyColor": "green"
        },

        "break",
        {
            "key": "",
            "type": "colors",
            "symbol": "circle",
            "keyColor": "39"
        }
    ]
}
